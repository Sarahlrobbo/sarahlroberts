---
// Figma (node 77:90208, "Navigation" — misnamed, this is the footer):
// tagline + illustration, "Explore"/"Contact" link columns, a divider,
// then a copyright line and a "Sarah Roberts" pill. The footer's own
// background (#fafafa, Figma's "surface/surface-page") is deliberately a
// touch different from the page background above it (var(--color-bg),
// white) — not a colour this codebase already has a token for, hence the
// raw hex rather than var(--color-bg). The scalloped border
// (public/images/footer/dotted-border.svg,
// a row of circles filled with that same #fafafa) sits on top of the
// boundary above the footer, cutting into whatever section precedes it —
// it only reads correctly because its fill matches the footer bg exactly.
// mt-[var(--spacing-2xlg)] (96px) is the standard gap before the footer,
// matching Figma — kept on the footer itself rather than on whatever
// page content precedes it, since the footer is site-wide (Layout.astro)
// and shouldn't rely on every page remembering to leave room for it.
const currentYear = new Date().getFullYear();
---

<footer class="relative mt-[var(--spacing-2xlg)] bg-[#fafafa] pt-[var(--spacing-xlg)] pb-[var(--spacing-lg)]">
  <img
    src="/images/footer/dotted-border.svg"
    alt=""
    aria-hidden="true"
    class="absolute inset-x-0 top-0 w-full -translate-y-1/2"
  />

  <div class="mx-auto flex max-w-[1440px] flex-col gap-[45px] px-[var(--spacing-xlg)]">
    <div class="flex flex-col items-start justify-between gap-[var(--spacing-xlg)] lg:flex-row">
      <div class="flex flex-col items-start gap-[var(--spacing-md)] sm:flex-row">
        <p class="text-style-intro text-[var(--color-text-secondary)] lg:w-[448px]">
          I help teams stop building things nobody asked for, and start building what customers actually need,
          before they even have to ask.
        </p>
        <div class="size-[150px] shrink-0 overflow-hidden rounded-[var(--radius-l)] mix-blend-multiply">
          <img src="/images/footer/illustration.png" alt="" aria-hidden="true" class="size-full object-cover" />
        </div>
      </div>

      <div class="flex items-start gap-[var(--spacing-xlg)]">
        <nav aria-label="Explore" class="flex w-[88px] flex-col items-start gap-[var(--spacing-sm)]">
          <p class="text-style-body text-[var(--color-text-secondary)]">Explore</p>
          <div class="flex flex-col items-start gap-[var(--spacing-xmd)]">
            <a href="/" class="text-style-body-semibold text-[var(--color-text-secondary)] hover:text-[var(--color-text-brand)]">
              Home
            </a>
            <a
              href="/#work"
              class="text-style-body-semibold whitespace-nowrap text-[var(--color-text-secondary)] hover:text-[var(--color-text-brand)]"
            >
              All Projects
            </a>
            <a
              href="/about"
              class="text-style-body-semibold text-[var(--color-text-secondary)] hover:text-[var(--color-text-brand)]"
            >
              About
            </a>
          </div>
        </nav>

        <nav aria-label="Contact" class="flex w-[79px] flex-col items-start gap-[var(--spacing-sm)]">
          <p class="text-style-body text-[var(--color-text-secondary)]">Contact</p>
          <div class="flex flex-col items-start gap-[var(--spacing-xmd)]">
            <a
              href="mailto:hello@sarahlroberts.com"
              class="text-style-body-semibold text-[var(--color-text-secondary)] hover:text-[var(--color-text-brand)]"
            >
              Email
            </a>
            <a
              href="https://www.linkedin.com/in/sarahlroberts-christchurch/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-style-body-semibold whitespace-nowrap text-[var(--color-text-secondary)] hover:text-[var(--color-text-brand)]"
            >
              LinkedIn
            </a>
            <a
              href="https://www.instagram.com/sarahlrobbo"
              target="_blank"
              rel="noopener noreferrer"
              class="text-style-body-semibold whitespace-nowrap text-[var(--color-text-secondary)] hover:text-[var(--color-text-brand)]"
            >
              Instagram
            </a>
          </div>
        </nav>
      </div>
    </div>

    <div class="flex flex-col items-start gap-[var(--spacing-sm)]">
      <div class="h-px w-full bg-[var(--color-border)]"></div>
      <div class="flex w-full flex-col items-start justify-between gap-[var(--spacing-sm)] sm:flex-row sm:items-center">
        <p class="text-style-body text-[var(--color-text-secondary)]">
          &copy; {currentYear} Sarah Roberts &middot; Designed in Aotearoa &#9968;&#128154;
        </p>
        <a
          href="/"
          class="text-style-intro-medium rounded-[var(--radius-m)] px-[var(--spacing-xmd)] py-[var(--spacing-sm)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-brand)]"
        >
          Sarah Roberts
        </a>
      </div>
    </div>
  </div>
</footer>
