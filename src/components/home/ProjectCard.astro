---
// Hover state per Figma 106:194022 (get_design_context on each card's real
// hover frame): a near-opaque accent-colour panel fades in over the photo,
// swapping the short title/logo for a longer description + this project's
// own tag pills, logo kept in the same corner. CSS-only (group-hover) since
// this page is desktop-only for now — no JS needed for a plain hover.
import CaseStudyImage from "../case-study/CaseStudyImage.astro";
import type { ProjectCard } from "../../lib/home";

interface Props {
  card: ProjectCard;
  class?: string;
}
const { card, class: className = "" } = Astro.props;
const textColor = card.textTone === "light" ? "text-[var(--color-text-invert)]" : "text-[var(--color-text-primary)]";

const hoverTextColor = card.hover.textTone === "light" ? "text-[var(--color-text-invert)]" : "text-[var(--color-text-primary)]";
const hoverBorderColor = card.hover.textTone === "light" ? "border-[var(--color-border)]" : "border-[var(--color-grey-600)]";
const hoverBg = `rgba(${parseInt(card.hover.color.slice(1, 3), 16)}, ${parseInt(card.hover.color.slice(3, 5), 16)}, ${parseInt(card.hover.color.slice(5, 7), 16)}, ${card.hover.opacity})`;
---

<a
  href={card.href}
  class={`group relative block overflow-hidden rounded-[var(--radius-l)] ${className}`}
>
  <CaseStudyImage image={{ src: card.src, alt: card.alt, aspect: card.aspect }} class="absolute inset-0 size-full" />
  {
    card.scrim && (
      <div class="pointer-events-none absolute inset-0 mix-blend-multiply" style={`background: ${card.scrim};`} />
    )
  }

  <!-- Default state: title + logo, bottom-aligned -->
  <div class="absolute inset-x-0 bottom-0 flex items-center justify-center gap-[var(--spacing-lg)] p-[var(--spacing-xmd)] opacity-100 transition-opacity duration-300 ease-[var(--ease-reveal)] group-hover:opacity-0">
    <p class={`flex-1 text-style-h4 ${textColor}`}>{card.title}</p>
    {
      card.logoSrc && (
        <img
          src={card.logoSrc}
          alt={card.logoAlt}
          style={`width: ${card.logoWidth}px; height: ${card.logoHeight}px;`}
          class="shrink-0 object-contain"
        />
      )
    }
  </div>

  <!-- Hover state: accent panel + description + tags, same logo -->
  <div
    class="absolute inset-0 flex flex-col items-center justify-between p-[var(--spacing-xmd)] opacity-0 transition-opacity duration-300 ease-[var(--ease-reveal)] group-hover:opacity-100"
    style={`background: ${hoverBg};`}
  >
    <div class="flex flex-1 items-center px-[var(--spacing-xmd)] pt-[var(--spacing-xmd)]">
      <p class={`text-style-h4-regular ${hoverTextColor}`}>{card.hover.description}</p>
    </div>
    <div class="flex w-full items-end justify-between pl-[var(--spacing-xmd)]">
      <div class="flex items-center gap-[var(--spacing-xmd)]">
        {
          card.hover.tags.map((tag) => (
            <span class={`rounded-[var(--radius-2xl)] border-[1.5px] ${hoverBorderColor} px-[var(--spacing-xmd)] py-[var(--spacing-2xs)] text-style-body-semibold ${hoverTextColor}`}>
              {tag}
            </span>
          ))
        }
      </div>
      {
        card.hover.logoSrc && (
          <img
            src={card.hover.logoSrc}
            alt={card.hover.logoAlt}
            style={`width: ${card.hover.logoWidth}px; height: ${card.hover.logoHeight}px;`}
            class="shrink-0 object-contain"
          />
        )
      }
    </div>
  </div>
</a>
