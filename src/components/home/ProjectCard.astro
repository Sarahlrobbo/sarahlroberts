---
// Hover state per Figma 106:194022 (get_design_context on each card's real
// hover frame): a near-opaque accent-colour panel fades in over the photo,
// swapping the short title for a longer description + this project's own
// tag pills. CSS-only (group-hover) since this page is desktop-only for
// now — no JS needed for a plain hover.
//
// The logo is a single persistent element, not part of either toggling
// layer. It used to be rendered once inside the default-state row and again
// inside the hover-state row — those two rows use different layout
// mechanisms (a bottom-anchored single row vs. a full-height flex-col split
// with justify-between), so even with matching padding values the logo
// landed at different pixel positions in each state and visibly jumped on
// hover (confirmed live: FarmIQ's logo shifted top by 20px, Datapay's
// happened to line up by coincidence). Hoisting it out to one fixed
// bottom-right position removes the ambiguity entirely — it can't jump if
// it's the same element in the same place the whole time.
import CaseStudyImage from "../case-study/CaseStudyImage.astro";
import type { ProjectCard } from "../../lib/home";

interface Props {
  card: ProjectCard;
  class?: string;
}
const { card, class: className = "" } = Astro.props;
const textColor = card.textTone === "light" ? "text-[var(--color-text-invert)]" : "text-[var(--color-text-primary)]";

const hoverTextColor = card.hover.textTone === "light" ? "text-[var(--color-text-invert)]" : "text-[var(--color-text-primary)]";
const hoverBorderColor = card.hover.textTone === "light" ? "border-[var(--color-border)]" : "border-[var(--color-grey-600)]";
const hoverBg = `rgba(${parseInt(card.hover.color.slice(1, 3), 16)}, ${parseInt(card.hover.color.slice(3, 5), 16)}, ${parseInt(card.hover.color.slice(5, 7), 16)}, ${card.hover.opacity})`;

// Both rows need to leave room on the right so their own content doesn't
// run under the now-independent logo.
const logoGutter = card.logoSrc ? `${card.logoWidth + 24}px` : "0px";

// All six cards' titles share one size (text-style-h4, 24px/32px — Sarah's
// call after trying a bigger size on the two FarmIQ cards and finding it
// inconsistent with the rest of the grid).
//
// The default-state title row is given a fixed min-height (2 lines' worth,
// --spacing-2xlg = 96px, matching text-style-h4's 32px line-height) and
// centers its text within that band regardless of whether the title wraps
// to 1 or 2 lines. The persistent logo below targets the vertical centre of
// that same band, so it lines up with the title instead of sitting pinned
// to the tile's bottom edge (which only looked right for 1-line titles —
// flagged by Sarah on the 2-line "Helping Farmers Thrive" card).
const logoBottomOffset = card.logoSrc ? `calc((var(--spacing-2xlg) - ${card.logoHeight}px) / 2)` : undefined;
---

<a
  href={card.href}
  class={`tile-hover-bounce group relative block overflow-hidden rounded-[var(--radius-l)] ${className}`}
>
  <CaseStudyImage image={{ src: card.src, alt: card.alt, aspect: card.aspect }} class="absolute inset-0 size-full" />
  {
    card.scrim && (
      <div class="pointer-events-none absolute inset-0 mix-blend-multiply" style={`background: ${card.scrim};`} />
    )
  }

  <!-- Default state: title, bottom-anchored but vertically centered within a
       fixed 2-line band so 1-line and 2-line titles both align with the logo -->
  <div
    class="absolute inset-x-0 bottom-0 flex min-h-[var(--spacing-2xlg)] items-center p-[var(--spacing-xmd)] opacity-100 transition-opacity duration-300 ease-[var(--ease-reveal)] group-hover:opacity-0"
    style={`padding-right: ${logoGutter};`}
  >
    <p class={`text-style-h4 ${textColor}`}>{card.title}</p>
  </div>

  <!-- Hover state: accent panel + description + tags -->
  <div
    class="absolute inset-0 flex flex-col items-center justify-between p-[var(--spacing-xmd)] opacity-0 transition-opacity duration-300 ease-[var(--ease-reveal)] group-hover:opacity-100"
    style={`background: ${hoverBg};`}
  >
    <div class="flex flex-1 items-center px-[var(--spacing-xmd)] pt-[var(--spacing-xmd)]">
      <p class={`w-3/4 text-style-body-semibold ${hoverTextColor}`}>{card.hover.description}</p>
    </div>
    <div class="flex w-full items-end pl-[var(--spacing-xmd)]" style={`padding-right: ${logoGutter};`}>
      <div class="flex flex-wrap items-center gap-[var(--spacing-xs)]">
        {
          card.hover.tags.map((tag) => (
            <span
              class={`shrink-0 whitespace-nowrap rounded-[var(--radius-2xl)] border-[1.5px] ${hoverBorderColor} px-[var(--spacing-xmd)] py-[var(--spacing-sm)] text-style-tag ${hoverTextColor}`}
            >
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Logo: fixed in place, present in both states, never re-rendered on hover -->
  {
    card.logoSrc && (
      <img
        src={card.logoSrc}
        alt={card.logoAlt}
        style={`width: ${card.logoWidth}px; height: ${card.logoHeight}px; bottom: ${logoBottomOffset};`}
        class="pointer-events-none absolute right-[var(--spacing-xmd)] z-10 object-contain"
      />
    )
  }
</a>
