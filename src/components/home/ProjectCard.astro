---
// Hover state per Figma 106:194022 (get_design_context on each card's real
// hover frame): a near-opaque accent-colour panel fades in over the photo,
// swapping the short title for a longer description + this project's own
// tag pills. CSS-only (group-hover) since this page is desktop-only for
// now — no JS needed for a plain hover.
//
// The logo is a single persistent element, not part of either toggling
// layer. It used to be rendered once inside the default-state row and again
// inside the hover-state row — those two rows use different layout
// mechanisms (a bottom-anchored single row vs. a full-height flex-col split
// with justify-between), so even with matching padding values the logo
// landed at different pixel positions in each state and visibly jumped on
// hover (confirmed live: FarmIQ's logo shifted top by 20px, Datapay's
// happened to line up by coincidence). Hoisting it out to one fixed
// bottom-right position removes the ambiguity entirely — it can't jump if
// it's the same element in the same place the whole time.
import CaseStudyImage from "../case-study/CaseStudyImage.astro";
import type { ProjectCard } from "../../lib/home";

interface Props {
  card: ProjectCard;
  class?: string;
}
const { card, class: className = "" } = Astro.props;
const textColor = card.textTone === "light" ? "text-[var(--color-text-invert)]" : "text-[var(--color-text-primary)]";

const hoverTextColor = card.hover.textTone === "light" ? "text-[var(--color-text-invert)]" : "text-[var(--color-text-primary)]";
const hoverBorderColor = card.hover.textTone === "light" ? "border-[var(--color-border)]" : "border-[var(--color-grey-600)]";
const hoverBg = `rgba(${parseInt(card.hover.color.slice(1, 3), 16)}, ${parseInt(card.hover.color.slice(3, 5), 16)}, ${parseInt(card.hover.color.slice(5, 7), 16)}, ${card.hover.opacity})`;

// Both rows need to leave room on the right so their own content doesn't
// run under the now-independent logo.
const logoGutter = card.logoSrc ? `${card.logoWidth + 24}px` : "0px";

// All six cards' titles share one size (text-style-h4, 24px/32px — Sarah's
// call after trying a bigger size on the two FarmIQ cards and finding it
// inconsistent with the rest of the grid).
//
// The default-state title row is given a fixed min-height (2 lines' worth,
// --spacing-2xlg = 96px, matching text-style-h4's 32px line-height) and
// centers its text within that band regardless of whether the title wraps
// to 1 or 2 lines. The persistent logo below targets the vertical centre of
// that same band, so it lines up with the title instead of sitting pinned
// to the tile's bottom edge (which only looked right for 1-line titles —
// flagged by Sarah on the 2-line "Helping Farmers Thrive" card).
const logoBottomOffset = card.logoSrc ? `calc((var(--spacing-2xlg) - ${card.logoHeight}px) / 2)` : undefined;
---

<a
  href={card.href}
  class={`tile-hover-bounce group relative grid overflow-hidden rounded-[var(--radius-l)] ${className}`}
>
  <!-- `[grid-area:1/1]` (a grid item, not `absolute inset-0`) so it sits in
       the same cell as the hover panel below. `project-tile-photo` is a
       hook for global.css: CaseStudyImage's own root div always sets an
       inline `aspect-ratio` style from `image.aspect` (used here as a
       height floor at desktop, where the outer tile's explicit height and
       this aspect-ratio agree exactly, by construction — same numbers,
       both read off Figma). At tablet the tile's real height instead comes
       from hover content (see the panel below) and is usually taller than
       that ratio allows — an inline style beats `align-items: stretch`
       every time (a plain class can't outrank it without `!important`),
       so without the override below the photo just stops short of the
       tile's real height, leaving blank space beneath it (Sarah flagged
       this, 2026-08-11 — screenshotted the gap under the DataPay
       illustration once tiles started growing for hover content). -->
  <CaseStudyImage image={{ src: card.src, alt: card.alt, aspect: card.aspect }} class="project-tile-photo [grid-area:1/1] w-full" />
  {
    card.scrim && (
      // project-tile-scrim: hook for a per-card !important override in
      // global.css (inline `style` always wins over a plain class) — see
      // the "Helping Farmers Thrive" override there for why one card
      // needed a taller tablet-only dark band than its own `card.scrim`
      // gives it.
      <div class="project-tile-scrim pointer-events-none absolute inset-0 mix-blend-multiply" style={`background: ${card.scrim};`} />
    )
  }

  <!-- Default state: title, bottom-anchored but vertically centered within a
       fixed 2-line band so 1-line and 2-line titles both align with the logo.
       project-tile-title-row: hook for a mobile-only padding-right override
       in global.css — this row's own logoGutter reserves space for the
       logo at its FULL (unscaled) width, but .project-tile-logo's
       transform: scale(0.75) on mobile only changes paint, not layout, so
       on mobile this was reserving ~35px more than the logo actually
       occupies there, taking width straight out of the title column (Sarah,
       2026-08-11 — wanted "Helping Farmers Thrive" and "Growing FarmIQ's
       Design Team" to wrap to 3 lines instead of 4). -->
  <div
    class="project-tile-title-row absolute inset-x-0 bottom-0 flex min-h-[var(--spacing-2xlg)] items-center p-[var(--spacing-xmd)] opacity-100 transition-opacity duration-300 ease-[var(--ease-reveal)] group-hover:opacity-0"
    style={`padding-right: ${logoGutter};`}
  >
    <p class={`text-style-h4 ${textColor}`}>{card.title}</p>
  </div>

  <!-- Hover state: accent panel + description + tags. `[grid-area:1/1]`
       instead of `absolute inset-0` — this is the one layer that needs to
       actually PARTICIPATE in the tile's sizing rather than just fill it:
       at tablet/mobile the tile's height is aspect-ratio-only, with nothing
       to stop long descriptions/many tags overflowing and getting clipped
       by `overflow-hidden` above (Sarah flagged this, 2026-08-11 — "if the
       content is too much to fit... make the tile taller"). Making `<a>` a
       grid container and this panel its sole grid item means the grid's
       auto row-track sizes to this panel's real content height when that's
       taller than the photo's aspect-ratio would otherwise give — then
       default `align-items: stretch` fills the panel back out to whatever
       height that resolves to, so it still always reads as a full-bleed
       colour panel, never a content-height island. Desktop (1440px+,
       .project-tile in global.css) still sets an explicit height, which
       always wins outright regardless of content — verified none of the
       four cards' hover content exceeds their real Figma height there, so
       desktop is visually unchanged.

       `relative` here (not just `[grid-area:1/1]`) matters for a subtler
       reason: CaseStudyImage's own root div hardcodes `position: relative`
       (it's shared with the case-study pages), which promotes the photo
       into the browser's "positioned elements" paint layer — that layer
       always paints above plain in-flow/static content, REGARDLESS of DOM
       order. Without this, the photo (painted in that later layer) covered
       the hover panel (left static) even though the panel comes later in
       the markup — confirmed by hovering for real and finding
       `document.elementFromPoint` still returned the photo's `<img>`
       through the supposedly-visible panel. Giving the panel `relative`
       too puts it in the same paint layer as the photo, where DOM order
       (panel after photo) decides — restoring the intended stacking. -->
  <div
    class="project-tile-hover-panel relative [grid-area:1/1] flex min-w-0 flex-col items-center justify-between gap-[var(--spacing-sm)] p-[var(--spacing-xmd)] opacity-0 transition-opacity duration-300 ease-[var(--ease-reveal)] group-hover:opacity-100"
    style={`background: ${hoverBg};`}
  >
    <div class="flex min-w-0 flex-1 items-center px-[var(--spacing-xmd)] pt-[var(--spacing-xmd)]">
      {
        /* w-full below 1440px, not the Figma-original w-3/4 everywhere —
           at tablet the card itself is already narrow (its width comes
           from splitting the row 50/50, see .project-tile in global.css),
           so 3/4 of that squeezed the description column down to ~243px,
           wrapping to as few as 3-4 words/line (Sarah's guidance: copy
           reads best around 6-8 words/line). w-3/4 still applies at
           1440px+ where the desktop box has room to spare — unaffected. */
      }
      <p class={`w-full text-style-body-semibold min-[1440px]:w-3/4 ${hoverTextColor}`}>{card.hover.description}</p>
    </div>
    {
      /* min-w-0 above and on the two rows below: flex items default to
         min-width:auto, not 0 — without overriding it, a child that can't
         shrink below its own content (the tag pills just below are
         shrink-0 + whitespace-nowrap by design, so they wrap onto new
         lines instead of squashing) forces that overflow back up through
         every ancestor flex container that also defaults to min-width:auto,
         including this SIBLING description block, even though nothing
         about the description itself needed the extra room. That's what
         was pushing the copy past the tile's right edge to get clipped by
         its overflow-hidden (Sarah flagged this, 2026-08-11, tablet
         screenshot — "needs padding on the right side"). gap-[…-sm] above
         is the fix for her other note in the same message, spacing between
         the copy and the tags — panel height is content-driven now (see
         the [grid-area:1/1] comment above), so with no explicit gap
         there's nothing forcing space between them once content fits
         exactly. */
    }
    <div class="flex w-full min-w-0 items-end pl-[var(--spacing-xmd)]" style={`padding-right: ${logoGutter};`}>
      <div class="flex min-w-0 flex-wrap items-center gap-[var(--spacing-xs)]">
        {
          card.hover.tags.map((tag) => (
            <span
              class={`shrink-0 whitespace-nowrap rounded-[var(--radius-2xl)] border-[1.5px] ${hoverBorderColor} px-[var(--spacing-xmd)] py-[var(--spacing-sm)] text-style-tag ${hoverTextColor}`}
            >
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Logo: fixed in place, present in both states, never re-rendered on hover.
       project-tile-logo: hook for a mobile-only `transform: scale()` in
       global.css (Sarah, 2026-08-11 — "25% smaller" on mobile). Scaling
       rather than shrinking width/height directly means it doesn't need
       !important to beat this element's own inline style, and with
       transform-origin set to the same bottom-right corner this logo is
       already anchored to (via `right`/`bottom` below), it shrinks toward
       that corner instead of its center — keeping the corner it's meant to
       align with visually fixed instead of introducing an uneven gap. -->
  {
    card.logoSrc && (
      <img
        src={card.logoSrc}
        alt={card.logoAlt}
        style={`width: ${card.logoWidth}px; height: ${card.logoHeight}px; bottom: ${logoBottomOffset};`}
        class="project-tile-logo pointer-events-none absolute right-[var(--spacing-xmd)] z-10 object-contain"
      />
    )
  }
</a>
