---
import type { CaseStudySection } from "../../lib/case-study";

interface Props {
  section: Extract<CaseStudySection, { type: "numberedList" }>;
}
const { section } = Astro.props;
---

<section class="mx-auto flex max-w-[1010px] flex-col gap-[var(--spacing-lg)] px-4 lg:mx-0 lg:ml-auto lg:mr-[var(--spacing-lg)] lg:px-0">
  <p class="text-style-intro text-[var(--color-text-primary)] lg:w-[600px]">{section.heading}</p>

  <div
    class:list={[
      "grid grid-cols-1 gap-x-[var(--spacing-xlg)] gap-y-[var(--spacing-xlg)]",
      section.columns === 2 && "lg:grid-cols-2",
    ]}
  >
    {
      section.items.map((item, i) => (
        <div class="flex flex-col gap-[var(--spacing-xmd)]">
          <div class="flex size-[60px] items-center justify-center rounded-[var(--radius-2xl)] bg-[var(--color-surface-primary)]">
            <p class="text-style-subheading text-[var(--color-text-secondary)]">{i + 1}</p>
          </div>
          <div
            class:list={[
              "flex flex-col gap-2 text-style-body text-[var(--color-text-primary)]",
              section.columns !== 2 && "lg:w-[600px]",
            ]}
          >
            <p class="text-style-body-semibold">{item.heading}</p>
            <p>{item.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
