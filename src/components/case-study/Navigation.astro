---
import Bars from "../icons/Bars.astro";

interface Props {
  authorName: string;
}
const { authorName } = Astro.props;
---

<nav class="flex items-center justify-between px-[var(--spacing-xmd)] py-[var(--spacing-sm)] lg:px-[var(--spacing-lg)] lg:w-[1440px] lg:max-w-full">
  <a
    href="/"
    class="text-style-intro-medium text-[var(--color-text-brand)] rounded-[var(--radius-m)] px-[var(--spacing-xmd)] py-[var(--spacing-sm)] lg:px-[var(--spacing-xmd)]"
  >
    {authorName}
  </a>

  <div class="hidden items-center gap-[6px] lg:flex">
    <a
      href="/#work"
      class="text-style-intro-medium text-[var(--color-text-secondary)] rounded-[var(--radius-m)] px-[var(--spacing-xmd)] py-[var(--spacing-sm)] hover:text-[var(--color-text-brand)]"
    >
      All Projects
    </a>
    <a
      href="/about"
      class="text-style-intro-medium text-[var(--color-text-secondary)] rounded-[var(--radius-m)] px-[var(--spacing-xmd)] py-[var(--spacing-sm)] hover:text-[var(--color-text-brand)]"
    >
      About
    </a>
  </div>

  <button
    type="button"
    aria-label="Open menu"
    class="flex size-6 items-center justify-center text-[var(--color-text-brand)] lg:hidden"
  >
    <Bars class="size-6" />
  </button>
</nav>
