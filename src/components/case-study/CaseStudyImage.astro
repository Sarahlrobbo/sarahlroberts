---
import type { CaseStudyImage } from "../../lib/case-study";

interface Props {
  image: CaseStudyImage;
  class?: string;
  rounded?: string;
}

const {
  image,
  class: className = "",
  rounded = image.rounded === false ? "" : "rounded-[var(--radius-l)]",
} = Astro.props;
const tone = image.captionTone ?? "light";
const fit = image.fit ?? "cover";
// captionBg colours can be a bold accent (dark enough for white text) or a
// pale swatch pulled straight from the image (needs dark text instead) —
// picking white unconditionally made pale bars unreadable. Standard
// relative-luminance check, same threshold used for WCAG-ish light/dark
// text decisions elsewhere on the web (~0.55 on the 0-1 scale).
function captionBgTextClass(hex?: string) {
  if (!hex) return "";
  const clean = hex.replace("#", "");
  const r = parseInt(clean.slice(0, 2), 16) / 255;
  const g = parseInt(clean.slice(2, 4), 16) / 255;
  const b = parseInt(clean.slice(4, 6), 16) / 255;
  const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return luminance > 0.55 ? "text-[var(--color-text-primary)]" : "text-[var(--color-text-invert)]";
}
// A loaded contain-fit image can letterbox (its own shape doesn't match the
// box). White reads as page background peeking through; grey-400 is only
// needed for the no-image-yet placeholder, where it has to contrast with
// the white placeholder text.
const wrapperBg = image.src && fit === "contain" ? "bg-white" : "bg-[var(--color-grey-400)]";
const earlyDesktop = image.earlyDesktop ?? false;
const aspectClass = image.aspectMobile
  ? image.aspectTablet
    ? "case-study-image-aspect-tablet"
    : earlyDesktop
      ? "case-study-image-aspect-sm"
      : "case-study-image-aspect"
  : "";
// Below lg, the caption (if any) moves out from an overlay on the photo to
// plain text underneath it — no image is guaranteed to have a clean, low-
// detail spot for white text at every crop, so overlaying doesn't hold up
// across breakpoints. At lg+ the original overlay treatment (scrim/
// captionBg/positioned text) is unchanged. Only images with a caption get
// the extra wrapper; captionless usages (ProjectCard, about.astro photos,
// the home hero fan) keep the exact single-div markup other CSS relies on
// (e.g. ProjectCard's `position: relative` root assumption).
const hasCaption = Boolean(image.caption) && !image.youtubeId;
const boxStyle = image.aspectMobile
  ? `--aspect-mobile: ${image.aspectMobile}; ${image.aspectTablet ? `--aspect-tablet: ${image.aspectTablet};` : ""} --aspect-desktop: ${image.aspect};`
  : `aspect-ratio: ${image.aspect};`;
const boxClass = `relative overflow-hidden ${rounded} ${wrapperBg} ${aspectClass}`;
---

{hasCaption && (
<div class={className}>
  <div class={boxClass} style={boxStyle}>
    {
    image.youtubeId ? (
      // This video's owner has embedding turned off (YouTube error 153 on
      // both the embed domains), and it isn't ours to override — link out
      // to the real watch page instead of trying to force an inline embed.
      <a
        href={`https://www.youtube.com/watch?v=${image.youtubeId}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Watch "${image.alt}" on YouTube (opens in a new window)`}
        class="group absolute inset-0"
        data-open-popup
      >
        <img
          src={`https://img.youtube.com/vi/${image.youtubeId}/maxresdefault.jpg`}
          alt=""
          class="size-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors group-hover:bg-black/35">
          <div class="flex size-16 items-center justify-center rounded-full bg-white/90 shadow-lg transition-transform group-hover:scale-110">
            <svg viewBox="0 0 24 24" class="ml-1 size-7 fill-[#283132]"><path d="M8 5v14l11-7z" /></svg>
          </div>
        </div>
      </a>
    ) : image.src && image.srcMobile ? (
      <Fragment>
        <img
          src={image.srcMobile}
          alt={image.alt}
          class={`absolute inset-0 size-full ${earlyDesktop ? "sm:hidden" : "lg:hidden"} ${fit === "cover" ? "object-cover" : "object-contain"}`}
          loading="lazy"
        />
        <img
          src={image.src}
          alt={image.alt}
          class={`absolute inset-0 hidden size-full ${earlyDesktop ? "sm:block" : "lg:block"} ${fit === "cover" ? "object-cover" : "object-contain"}`}
          loading="lazy"
        />
      </Fragment>
    ) : image.src ? (
      <img
        src={image.src}
        alt={image.alt}
        class={`absolute inset-0 size-full ${fit === "cover" ? "object-cover" : "object-contain"}`}
        loading="lazy"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center border-2 border-dashed border-[var(--color-text-invert)]/30 text-center">
        {!image.caption && (
          <span class="text-style-caption not-italic px-4 text-[var(--color-text-invert)]">{image.alt}</span>
        )}
      </div>
    )
  }
  {
    /* Overlay caption treatment — lg+ only below. Below lg the caption
       renders as plain text under the image instead (see the closing
       paragraph below), so no scrim is needed there. */
  }
  {
    !image.captionBg && tone === "light" && !image.captionScrimStrong && (
      <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-b from-white/50 from-75% to-[#283132]/50 mix-blend-multiply lg:block" />
    )
  }
  {
    !image.captionBg && tone === "light" && image.captionScrimStrong && (
      <div class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-[70%] bg-gradient-to-t from-black/45 via-black/28 via-40% to-transparent lg:block" />
    )
  }
  {
    image.captionBg && (
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 hidden px-[var(--spacing-xmd)] py-[10px] lg:block"
        style={`background-color: ${image.captionBg};`}
      >
        <p class={`text-style-caption ${captionBgTextClass(image.captionBg)}`}>{image.caption}</p>
      </div>
    )
  }
  {
    !image.captionBg && (
      <div class="pointer-events-none absolute bottom-0 left-0 hidden px-[var(--spacing-xmd)] py-[10px] lg:block">
        <p
          class={`text-style-caption ${
            tone === "light" ? "text-[var(--color-text-invert)]" : "text-[var(--color-text-secondary)]"
          }`}
        >
          {image.caption}
        </p>
      </div>
    )
  }
  </div>
  <p class="text-style-caption pt-[var(--spacing-sm)] text-[var(--color-text-secondary)] italic lg:hidden">
    {image.caption}
  </p>
</div>
)}
{!hasCaption && (
<div class={`${boxClass} ${className}`} style={boxStyle}>
  {
    image.youtubeId ? (
      // This video's owner has embedding turned off (YouTube error 153 on
      // both the embed domains), and it isn't ours to override — link out
      // to the real watch page instead of trying to force an inline embed.
      <a
        href={`https://www.youtube.com/watch?v=${image.youtubeId}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Watch "${image.alt}" on YouTube`}
        class="group absolute inset-0"
        data-open-popup
      >
        <img
          src={`https://img.youtube.com/vi/${image.youtubeId}/maxresdefault.jpg`}
          alt=""
          class="size-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors group-hover:bg-black/35">
          <div class="flex size-16 items-center justify-center rounded-full bg-white/90 shadow-lg transition-transform group-hover:scale-110">
            <svg viewBox="0 0 24 24" class="ml-1 size-7 fill-[#283132]"><path d="M8 5v14l11-7z" /></svg>
          </div>
        </div>
      </a>
    ) : image.src && image.srcMobile ? (
      <Fragment>
        <img
          src={image.srcMobile}
          alt={image.alt}
          class={`absolute inset-0 size-full ${earlyDesktop ? "sm:hidden" : "lg:hidden"} ${fit === "cover" ? "object-cover" : "object-contain"}`}
          loading="lazy"
        />
        <img
          src={image.src}
          alt={image.alt}
          class={`absolute inset-0 hidden size-full ${earlyDesktop ? "sm:block" : "lg:block"} ${fit === "cover" ? "object-cover" : "object-contain"}`}
          loading="lazy"
        />
      </Fragment>
    ) : image.src ? (
      <img
        src={image.src}
        alt={image.alt}
        class={`absolute inset-0 size-full ${fit === "cover" ? "object-cover" : "object-contain"}`}
        loading="lazy"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center border-2 border-dashed border-[var(--color-text-invert)]/30 text-center">
        <span class="text-style-caption not-italic px-4 text-[var(--color-text-invert)]">{image.alt}</span>
      </div>
    )
  }
</div>
)}

<script>
  // target="_blank" opens a new tab in most browsers. Passing explicit
  // window features to window.open forces an actual separate popup window
  // instead, which is what "open in a new window" means here.
  document.querySelectorAll<HTMLAnchorElement>("[data-open-popup]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      window.open(
        link.href,
        "_blank",
        "noopener,noreferrer,width=1280,height=720,menubar=no,toolbar=no,location=no,status=no",
      );
    });
  });
</script>
