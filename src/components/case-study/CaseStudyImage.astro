---
import type { CaseStudyImage } from "../../lib/case-study";

interface Props {
  image: CaseStudyImage;
  class?: string;
  rounded?: string;
}

const {
  image,
  class: className = "",
  rounded = image.rounded === false ? "" : "rounded-[var(--radius-l)]",
} = Astro.props;
const tone = image.captionTone ?? "light";
const fit = image.fit ?? "cover";
// A loaded contain-fit image can letterbox (its own shape doesn't match the
// box). White reads as page background peeking through; grey-400 is only
// needed for the no-image-yet placeholder, where it has to contrast with
// the white placeholder text.
const wrapperBg = image.src && fit === "contain" ? "bg-white" : "bg-[var(--color-grey-400)]";
const earlyDesktop = image.earlyDesktop ?? false;
const aspectClass = image.aspectMobile
  ? image.aspectTablet
    ? "case-study-image-aspect-tablet"
    : earlyDesktop
      ? "case-study-image-aspect-sm"
      : "case-study-image-aspect"
  : "";
---

<div
  class={`relative overflow-hidden ${rounded} ${wrapperBg} ${className} ${aspectClass}`}
  style={
    image.aspectMobile
      ? `--aspect-mobile: ${image.aspectMobile}; ${image.aspectTablet ? `--aspect-tablet: ${image.aspectTablet};` : ""} --aspect-desktop: ${image.aspect};`
      : `aspect-ratio: ${image.aspect};`
  }
>
  {
    image.youtubeId ? (
      // This video's owner has embedding turned off (YouTube error 153 on
      // both the embed domains), and it isn't ours to override — link out
      // to the real watch page instead of trying to force an inline embed.
      <a
        href={`https://www.youtube.com/watch?v=${image.youtubeId}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Watch "${image.alt}" on YouTube`}
        class="group absolute inset-0"
        data-open-popup
      >
        <img
          src={`https://img.youtube.com/vi/${image.youtubeId}/maxresdefault.jpg`}
          alt=""
          class="size-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors group-hover:bg-black/35">
          <div class="flex size-16 items-center justify-center rounded-full bg-white/90 shadow-lg transition-transform group-hover:scale-110">
            <svg viewBox="0 0 24 24" class="ml-1 size-7 fill-[#283132]"><path d="M8 5v14l11-7z" /></svg>
          </div>
        </div>
      </a>
    ) : image.src && image.srcMobile ? (
      <Fragment>
        <img
          src={image.srcMobile}
          alt={image.alt}
          class={`absolute inset-0 size-full ${earlyDesktop ? "sm:hidden" : "lg:hidden"} ${fit === "cover" ? "object-cover" : "object-contain"}`}
          loading="lazy"
        />
        <img
          src={image.src}
          alt={image.alt}
          class={`absolute inset-0 hidden size-full ${earlyDesktop ? "sm:block" : "lg:block"} ${fit === "cover" ? "object-cover" : "object-contain"}`}
          loading="lazy"
        />
      </Fragment>
    ) : image.src ? (
      <img
        src={image.src}
        alt={image.alt}
        class={`absolute inset-0 size-full ${fit === "cover" ? "object-cover" : "object-contain"}`}
        loading="lazy"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center border-2 border-dashed border-[var(--color-text-invert)]/30 text-center">
        {!image.caption && (
          <span class="text-style-caption not-italic px-4 text-[var(--color-text-invert)]">{image.alt}</span>
        )}
      </div>
    )
  }
  {
    !image.youtubeId && image.caption && tone === "light" && (
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-white/50 from-75% to-[#283132]/50 mix-blend-multiply" />
    )
  }
  {
    !image.youtubeId && image.caption && (
      <div class="pointer-events-none absolute bottom-0 left-0 px-[var(--spacing-xmd)] py-[10px]">
        <p
          class={`text-style-caption ${
            tone === "light" ? "text-[var(--color-text-invert)]" : "text-[var(--color-text-secondary)]"
          }`}
        >
          {image.caption}
        </p>
      </div>
    )
  }
</div>

<script>
  // target="_blank" opens a new tab in most browsers. Passing explicit
  // window features to window.open forces an actual separate popup window
  // instead, which is what "open in a new window" means here.
  document.querySelectorAll<HTMLAnchorElement>("[data-open-popup]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      window.open(
        link.href,
        "_blank",
        "noopener,noreferrer,width=1280,height=720,menubar=no,toolbar=no,location=no,status=no",
      );
    });
  });
</script>
