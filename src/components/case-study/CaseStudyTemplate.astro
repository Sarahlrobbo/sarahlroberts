---
import type { CaseStudy, SpacingBefore } from "../../lib/case-study";
import { slugify } from "../../lib/case-study";
import Cover from "./Cover.astro";
import IntroSection from "./IntroSection.astro";
import TextSection from "./TextSection.astro";
import TextImageSection from "./TextImageSection.astro";
import ImageBand from "./ImageBand.astro";
import NumberedList from "./NumberedList.astro";
import OutcomeSection from "./OutcomeSection.astro";
import QuoteSlider from "./QuoteSlider.astro";
import BackToTop from "./BackToTop.astro";
import SectionNav from "./SectionNav.astro";

interface Props {
  caseStudy: CaseStudy;
}
const { caseStudy } = Astro.props;

// Figma's actual block rhythm, confirmed from the Main content / Bottom
// frame containers (both `flex flex-col gap-[96px]`), not approximated.
const SPACING_CLASS: Record<SpacingBefore, string> = {
  tighter: "mt-[var(--spacing-md)]", // 24px — sub-image to sub-image within one image group
  tight: "mt-[var(--spacing-lg)]", // 40px — an image band attached under the heading it illustrates
  loose: "mt-[var(--spacing-2xlg)]", // 96px — the default gap between every top-level block
};

// Figma's two full-bleed background panels ("My Role & Situation BG Dots",
// node 64:102934, and "Solution BG", node 64:141385). See the `background`
// field doc comment on CaseStudySection for how sections opt in.
const PANEL_BG_CLASS = {
  dots: "bg-dot-grid",
  solid: "bg-[var(--color-surface-primary)]",
} as const;

const COMPONENT_FOR_TYPE = {
  intro: IntroSection,
  text: TextSection,
  textImage: TextImageSection,
  imageBand: ImageBand,
  numberedList: NumberedList,
  outcome: OutcomeSection,
  quoteSlider: QuoteSlider,
  backToTop: BackToTop,
} as const;

const renderableSections = caseStudy.sections.map((section, i) => ({
  id: section.navLabel ? slugify(section.navLabel) : undefined,
  spacingClass: i === 0 ? "" : SPACING_CLASS[section.spacingBefore ?? "loose"],
  Component: COMPONENT_FOR_TYPE[section.type],
  section,
}));

type RenderableSection = (typeof renderableSections)[number];

// Consecutive sections sharing the same `background` collapse into one
// panel entry. The panel absorbs the leading section's own spacingClass
// (the gap that would otherwise sit *above* the panel) as its own
// margin-top, and zeroes that section's margin so it doesn't double up
// with the panel's internal top padding.
type RenderEntry =
  | ({ kind: "section" } & RenderableSection)
  | { kind: "panel"; background: "dots" | "solid"; leadingSpacingClass: string; items: RenderableSection[] };

function groupByBackground(items: RenderableSection[]): RenderEntry[] {
  const entries: RenderEntry[] = [];
  for (const item of items) {
    const bg = item.section.background;
    const last = entries[entries.length - 1];
    if (bg && last?.kind === "panel" && last.background === bg) {
      last.items.push(item);
    } else if (bg) {
      entries.push({ kind: "panel", background: bg, leadingSpacingClass: item.spacingClass, items: [{ ...item, spacingClass: "" }] });
    } else {
      entries.push({ kind: "section", ...item });
    }
  }
  return entries;
}

const navItems = caseStudy.sections
  .filter((s) => s.navLabel)
  .map((s) => ({ id: slugify(s.navLabel!), label: s.navLabel! }));

// The nav's sticky range runs from the very start of the page content
// (the Intro block, so the nav's top aligns with "Company, Role" — the
// first line under the Cover) through the last linked section ("What I
// Learned"). Sections outside that range (just BackToTop here) render
// normally, outside the flex row.
const lastNavIndex = caseStudy.sections.reduce((last, s, i) => (s.navLabel ? i : last), -1);
const inRange = groupByBackground(renderableSections.slice(0, lastNavIndex + 1));
const afterRange = renderableSections.slice(lastNavIndex + 1);
---

<article id="top" class="mx-auto max-w-[1440px]">
  <Cover
    title={caseStudy.title}
    authorName={caseStudy.authorName}
    background={caseStudy.cover.background}
    deviceImage={caseStudy.cover.deviceImage}
    deviceImageMobile={caseStudy.cover.deviceImageMobile}
  />

  <div class="lg:flex lg:items-start lg:gap-[var(--spacing-xmd)] lg:pl-[var(--spacing-lg)]">
    <SectionNav items={navItems} backHref={caseStudy.backHref ?? "/"} />
    <div class="lg:min-w-0 lg:flex-1">
      {
        inRange.map((entry) => {
          if (entry.kind === "panel") {
            const { leadingSpacingClass, background, items } = entry;
            return (
              <div class={leadingSpacingClass}>
                <div class="relative pt-[var(--spacing-xlg)] pb-[var(--spacing-xlg)]">
                  {
                    /*
                      The sidebar (SectionNav, 188px) + its gap (16px) + the
                      row's left padding (40px) push this content column
                      244px right of the article's own left edge — so the
                      outer div corrects for *that* first, landing exactly on
                      the article's box (0–1440, viewport-centered like
                      Cover's parent is). Only then can the inner div reuse
                      Cover's left-1/2/w-screen/-translate-x-1/2 bleed trick
                      and land on the true viewport edges — that trick only
                      self-centers correctly when its containing block's
                      center already matches the viewport's, which the raw
                      content column's does not (it's shifted right by the
                      sidebar).
                    */
                  }
                  <div aria-hidden="true" class="absolute inset-0 -z-10 lg:left-[-244px]">
                    <div class={`absolute inset-0 lg:left-1/2 lg:right-auto lg:w-screen lg:-translate-x-1/2 ${PANEL_BG_CLASS[background]}`} />
                  </div>
                  {items.map(({ id, spacingClass, Component, section }) => (
                    <div id={id} class={spacingClass}>
                      <Component section={section} />
                    </div>
                  ))}
                </div>
              </div>
            );
          }
          const { id, spacingClass, Component, section } = entry;
          return (
            <div id={id} class={spacingClass}>
              <Component section={section} />
            </div>
          );
        })
      }
    </div>
  </div>

  {
    afterRange.map(({ id, spacingClass, Component, section }) => (
      <div id={id} class={spacingClass}>
        <Component section={section} />
      </div>
    ))
  }
</article>
