---
import type { CaseStudyImage } from "../../lib/case-study";
import Navigation from "./Navigation.astro";

interface Props {
  title: string;
  authorName: string;
  background: CaseStudyImage;
  deviceImage: CaseStudyImage;
  deviceImageMobile?: CaseStudyImage;
}
const { title, authorName, background, deviceImage, deviceImageMobile = deviceImage } = Astro.props;
const titleLines = title.split("\n");
---

<!--
  Figma: Cover is a fixed-height frame on desktop (810px), background photo
  filling it, heading + device screenshot bottom-anchored inside. On mobile
  the device mockup is genuinely taller than a fixed 632px allows without
  cutting it off mid-content, so mobile height is content-driven (auto) —
  it never clips the mockup — while desktop keeps its fixed 810px.

  The page article is capped at max-w-[1440px] and centered, but the Cover
  itself needs to stay full-bleed to the viewport on wider screens (like
  nataliealmosa.ca/notion-mail) rather than getting capped with it. The
  relative/left-1/2/-translate-x-1/2/w-screen combination breaks it out of
  that parent regardless of the parent's own width, independent of how deep
  it's nested.
-->
<div
  data-parallax-root
  class="relative left-1/2 h-auto w-screen -translate-x-1/2 overflow-hidden rounded-b-[var(--radius-xl)] lg:h-[810px] lg:rounded-b-[var(--radius-2xlg)]"
>
  <div class="absolute inset-0 -z-10">
    {
      background.src ? (
        // Russel (the farmer) sits at roughly the 15% mark from the left of
        // the source photo, not centre. Default object-position (50% 50%)
        // crops him out entirely on narrow/mobile widths, since the crop
        // window is centred on the image's geometric middle instead of on
        // him. Anchoring the crop to his actual position keeps him in frame
        // at every width instead.
        <img src={background.src} alt="" class="size-full object-cover object-[15%_center]" />
      ) : (
        <div class="size-full bg-[var(--color-grey-300)]" />
      )
    }
  </div>

  <div class="absolute inset-x-0 top-0">
    <Navigation authorName={authorName} />
  </div>

  <!--
    Mobile: normal document flow (not absolute), so its natural height is
    what drives the parent's h-auto — nothing gets clipped, no matter how
    tall the device mockup is. Title starts pt-[--spacing-2xlg] (96px) from
    the Cover's top — Figma measures ~92px to the glyph's visual top, but
    the actual box value is the 2xlg token; the 4px gap is just Syne's line
    leading above the cap height, not a distinct spacing value.
    Desktop: unchanged, absolute + bottom-anchored inside the fixed 810px
    box (this was never reported as broken).
  -->
  <div class="relative flex w-full flex-col items-center gap-[var(--spacing-lg)] pt-[var(--spacing-2xlg)] lg:absolute lg:bottom-0 lg:left-1/2 lg:w-[900px] lg:max-w-[900px] lg:-translate-x-1/2 lg:pt-0">
    <h1 class="text-style-h1 max-w-[340px] px-4 text-center text-[var(--color-text-primary)] lg:max-w-[784px] lg:px-0">
      {titleLines.map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </h1>

    <div data-parallax-fg class="w-full px-[var(--spacing-md)] pb-[var(--spacing-md)] lg:px-0 lg:pb-0">
      {/* Mobile-specific crop/composition */}
      <div class="overflow-hidden rounded-t-[24px] lg:hidden" style={`aspect-ratio: ${deviceImageMobile.aspect};`}>
        {
          deviceImageMobile.src ? (
            <img src={deviceImageMobile.src} alt={deviceImageMobile.alt} class="size-full object-contain" />
          ) : (
            <div class="flex size-full items-center justify-center bg-[var(--color-grey-400)]">
              <span class="text-style-caption not-italic px-4 text-center text-[var(--color-text-invert)]">
                {deviceImageMobile.alt}
              </span>
            </div>
          )
        }
      </div>
      {/* Desktop crop/composition */}
      <div
        class="hidden overflow-hidden rounded-t-[24px] lg:block"
        style={`aspect-ratio: ${deviceImage.aspect};`}
      >
        {
          deviceImage.src ? (
            <img src={deviceImage.src} alt={deviceImage.alt} class="size-full object-contain" />
          ) : (
            <div class="flex size-full items-center justify-center bg-[var(--color-grey-400)]">
              <span class="text-style-caption not-italic px-4 text-center text-[var(--color-text-invert)]">
                {deviceImage.alt}
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<script>
  // Parallax: the device-image mockup rises faster than the background photo
  // as the hero scrolls out of view, so it climbs up over the title rather
  // than trailing behind it. Background gets no extra transform (it just
  // moves at normal document-scroll speed); the mockup gets an added upward
  // translateY on top of that, proportional to how far the hero has
  // scrolled past the top of the viewport. Skipped for prefers-reduced-motion.
  const PARALLAX_FACTOR = 0.2;

  function initParallax(root: HTMLElement) {
    const fg = root.querySelector<HTMLElement>("[data-parallax-fg]");
    if (!fg) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (reduceMotion.matches) return;

    let ticking = false;

    function update() {
      ticking = false;
      const { top, bottom } = root.getBoundingClientRect();
      if (bottom < 0 || top > window.innerHeight) return; // hero off-screen, nothing to do
      // top is 0 or negative as the hero scrolls up; multiplying by a
      // positive factor keeps the sign negative, i.e. always an upward shift.
      fg!.style.transform = `translateY(${top * PARALLAX_FACTOR}px)`;
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    update();
  }

  document.querySelectorAll<HTMLElement>("[data-parallax-root]").forEach(initParallax);
</script>
