---
import ArrowUp from "../icons/ArrowUp.astro";
---

<div class="mx-auto max-w-[1010px] px-4 lg:mx-0 lg:ml-auto lg:mr-[var(--spacing-lg)] lg:px-0">
  <a
    href="#top"
    class="inline-flex items-center gap-[var(--spacing-sm)] rounded-[var(--radius-m)] px-[var(--spacing-xmd)] py-[var(--spacing-sm)] text-[var(--color-text-brand)] hover:opacity-80"
  >
    <ArrowUp class="size-4" />
    <span class="text-style-intro-medium">Back to top</span>
  </a>
</div>
