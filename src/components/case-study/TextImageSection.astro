---
import type { CaseStudySection } from "../../lib/case-study";
import { renderInline } from "../../lib/case-study";
import CaseStudyImage from "./CaseStudyImage.astro";

interface Props {
  section: Extract<CaseStudySection, { type: "textImage" }>;
}
const { section } = Astro.props;
// Desktop image width + copy/image gap come from the Figma asset frame per
// case study (keeping-kiwis-safe's Solution asset is 339px with a 71px gap,
// vs the 267/40 the shared layout was first built around). Applied as CSS
// vars so only the `lg:` layer changes — mobile stacking is untouched.
const imageMaxWidth = section.imageMaxWidth ?? 267;
const copyImageGap = section.copyImageGap ?? 40;
---

<section
  class="mx-auto flex max-w-[1010px] flex-col gap-[var(--spacing-md)] px-4 lg:mx-0 lg:ml-auto lg:mr-[var(--spacing-lg)] lg:flex-row lg:items-start lg:gap-[var(--cs-copy-image-gap)] lg:px-0"
  style={`--cs-copy-image-gap: ${copyImageGap}px; --cs-image-max-width: ${imageMaxWidth}px;`}
>
  <div class="flex flex-col gap-4 lg:w-[600px] lg:shrink-0">
    <p class="text-style-intro text-[var(--color-text-primary)]">{section.heading}</p>
    <div class="flex flex-col gap-[var(--spacing-md)] text-style-body text-[var(--color-text-primary)]">
      {section.paragraphs.map((p) => <p set:html={renderInline(p)} />)}
    </div>
  </div>

  <div class="flex flex-1 items-center justify-center">
    <CaseStudyImage
      image={section.image}
      class="w-full sm:max-w-[400px] lg:max-w-[var(--cs-image-max-width)]"
    />
  </div>
</section>
