---
// Desktop scrolling section nav (Figma node 79:39278 — "Back" + 6
// section jump-links, active one highlighted brand-blue).
//
// This is a real flex sibling of the content column (see
// CaseStudyTemplate's `lg:flex` wrapper), not a fixed/calc-positioned
// overlay — so it can never overlap content at any width: flexbox itself
// carves out its 188px + gap, and the content column (each section keeps
// its own `max-w-[1010px]` capped width) simply shrinks to fill whatever
// width remains. That's also why it can safely show from 1024px up
// instead of needing a wide-viewport safety margin — below 1440px the
// content column is narrower than Figma's fixed 1010px, which is a
// deliberate trade-off to keep the nav usable in ordinary window widths
// rather than only on very wide monitors.
//
// `position: sticky` lets it start at its natural position (aligned with
// the top of the Intro block, i.e. level with "Company, Role" — the
// mt-[spacing-xlg] below matches Intro's own top padding) and then stick
// as the page scrolls through that range, unstuck again once it ends.
interface Props {
  items: { id: string; label: string }[];
  backHref: string;
  /**
   * Fade + slide the nav away while a full-bleed image band is scrolling
   * through its pinned zone, then bring it back. Opt-in — see
   * CaseStudy.dimNavOverWideBands.
   */
  dimOverWideBands?: boolean;
}
const { items, backHref, dimOverWideBands = false } = Astro.props;
---

<nav
  class="section-nav hidden lg:block lg:sticky lg:top-24 lg:mt-[var(--spacing-xlg)] lg:w-[188px] lg:shrink-0"
  aria-label="Case study sections"
  data-dim-over-wide={dimOverWideBands ? "" : undefined}
>
  <div class="flex w-full flex-col items-start gap-[var(--spacing-md)]">
    <a
      href={backHref}
      class="text-style-nav flex items-center gap-[var(--spacing-sm)] rounded-[var(--radius-m)] px-[var(--spacing-xmd)] py-[var(--spacing-sm)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-brand)]"
    >
      <span aria-hidden="true">←</span> Back
    </a>
    <div class="flex w-full flex-col items-start">
      {
        items.map((item) => (
          <a
            href={`#${item.id}`}
            data-nav-link={item.id}
            class="text-style-nav w-full rounded-[var(--radius-m)] px-[var(--spacing-xmd)] py-[var(--spacing-sm)] text-[var(--color-text-secondary)] transition-colors aria-[current=true]:text-[var(--color-text-brand)]"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style>
  /* `dimOverWideBands`: while a full-bleed image band sits over the pinned
     nav's zone, wipe the nav out in place with a `mask-image` gradient (no
     blur, no positional slide). Hide and reveal are *separate* keyframes,
     not one reversed transition, so both read bottom-edge-first: on hide the
     wipe eats up from the bottom; on reveal it fills up from the bottom too.
     The two hidden anchors (mask +100% vs -100%) both render fully masked,
     so the swap between animations is invisible. Binary state — see script. */
  .section-nav[data-dim-over-wide] {
    -webkit-mask-image: linear-gradient(to bottom, #000 0 50%, transparent 50% 100%);
    mask-image: linear-gradient(to bottom, #000 0 50%, transparent 50% 100%);
    -webkit-mask-size: 100% 200%;
    mask-size: 100% 200%;
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
  }
  .section-nav[data-dim-over-wide][data-nav-hidden="true"] {
    animation: nav-wipe-out 280ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    pointer-events: none;
  }
  .section-nav[data-dim-over-wide][data-nav-hidden="false"] {
    animation: nav-wipe-in 300ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes nav-wipe-out {
    from {
      opacity: 1;
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
    to {
      opacity: 0;
      -webkit-mask-position: 0 100%;
      mask-position: 0 100%;
    }
  }
  @keyframes nav-wipe-in {
    from {
      opacity: 0;
      -webkit-mask-position: 0 -100%;
      mask-position: 0 -100%;
    }
    to {
      opacity: 1;
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .section-nav[data-dim-over-wide],
    .section-nav[data-dim-over-wide][data-nav-hidden="true"],
    .section-nav[data-dim-over-wide][data-nav-hidden="false"] {
      animation: none;
      transition: opacity 140ms linear;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .section-nav[data-dim-over-wide][data-nav-hidden="true"] {
      opacity: 0;
    }
  }
</style>

<script>
  // Toggle a single `data-nav-hidden` state while any full-bleed element
  // (`data-covers-nav` — wide image bands, the pinned quote carousel)
  // overlaps the nav's *current* rect (which shifts as the sticky nav
  // pins/unpins). CSS owns the actual animation. rAF-throttled scroll check,
  // a few getBoundingClientRect reads.
  const dimNav = document.querySelector<HTMLElement>(".section-nav[data-dim-over-wide]");
  const wideBands = document.querySelectorAll<HTMLElement>("[data-covers-nav]");
  if (dimNav && wideBands.length) {
    let ticking = false;
    let hidden = false;
    const sync = () => {
      ticking = false;
      const nav = dimNav.getBoundingClientRect();
      let overlapped = false;
      for (const band of wideBands) {
        const b = band.getBoundingClientRect();
        if (b.top < nav.bottom && b.bottom > nav.top) {
          overlapped = true;
          break;
        }
      }
      if (overlapped !== hidden) {
        hidden = overlapped;
        dimNav.setAttribute("data-nav-hidden", hidden ? "true" : "false");
      }
    };
    const schedule = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(sync);
      }
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    sync();
  }

  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  if (links.length) {
    const targets = [...links]
      .map((link) => document.getElementById(link.dataset.navLink!))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string | null) => {
      for (const link of links) {
        link.setAttribute("aria-current", link.dataset.navLink === id ? "true" : "false");
      }
    };

    const activeObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) {
          const topMost = visible.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          setActive(topMost.target.id);
        }
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: 0 },
    );
    targets.forEach((el) => activeObserver.observe(el));
  }
</script>
